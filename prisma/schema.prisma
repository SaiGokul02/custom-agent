generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MealTimes {
  breakfast
  morningSnack
  lunch
  eveningSnack
  dinner
}

enum Role {
  human
  ai
}

model users {
  id            String          @id @default(cuid())
  username      String          @unique
  email         String          @unique
  password      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  conversations Conversations[]
  foodLogs      FoodTracker[]
  settings      UserSettings?
}

model Nutrition {
  id               String        @id @default(cuid())
  food             String
  servingLabel     String
  baseQuantity     Float
  calories         Float
  carbohydrates    Float
  protein          Float
  fat              Float
  fiber            Float
  sugar            Float
  sodium           Float
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  foodTrackerItems FoodTracker[]

  @@map("nutrition")
}

model UserSettings {
  id                String             @id @default(cuid())
  userId            String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  nutritionSettings NutritionSettings?
  user              users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSettings   WorkoutSettings?
}

model NutritionSettings {
  id            String       @id @default(cuid())
  calorieTarget Float?
  settingsId    String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  settings      UserSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model WorkoutSettings {
  id         String       @id @default(cuid())
  settingsId String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  settings   UserSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model FoodTracker {
  id          String     @id @default(cuid())
  userId      String
  nutritionId String
  quantity    Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mealTime    MealTimes?
  nutrition   Nutrition  @relation(fields: [nutritionId], references: [id], onDelete: Cascade)
  user        users      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversations {
  id        String    @id @default(cuid())
  userId    String
  threadId  String    @unique
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      users     @relation(fields: [userId], references: [id])
  messages  Message[]
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@ignore
}

model checkpoint_migrations {
  v Int @id

  @@ignore
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@ignore
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@ignore
}

model Message {
  id            String        @id @default(cuid())
  threadId      String
  conversation  Conversations @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  role          Role
  content       String
  createdAt     DateTime      @default(now())
}
